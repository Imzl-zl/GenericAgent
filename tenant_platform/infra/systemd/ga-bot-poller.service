[Unit]
Description=GenericAgent WeChat Bot Poller
Documentation=https://github.com/Imzl-zl/GenericAgent/tree/main/tenant_platform/docs/bot-poller-auth.md
After=network-online.target
Wants=network-online.target
Before=ga-platform.service

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s

MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
UMask=0027

# Contains only the two poller HMAC secrets and loopback/media settings.
# Platform and Document Manager configuration are hidden inside this unit.
EnvironmentFile=-/etc/ga/bot-poller.env

User=ga-bot
Group=ga-bot
SupplementaryGroups=ga-delivery
WorkingDirectory=/opt/ga/legacy
ExecStart=/usr/bin/python3 /opt/ga/legacy/tenant_platform/bot_poller/poller_server.py

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/podman/podman.sock -/var/run/podman/podman.sock -/run/user /etc/ga/bot-poller.env /etc/ga/platform.env /etc/ga/document-manager.env /var/lib/ga/documents /var/lib/ga/runtime /etc/ga/config /opt/ga/worker-python
BindReadOnlyPaths=-/var/lib/ga/runtime/session_files
UnsetEnvironment=DOCKER_HOST CONTAINER_HOST
ReadWritePaths=/var/lib/ga/bot-media
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ga-bot-poller

[Install]
WantedBy=multi-user.target
