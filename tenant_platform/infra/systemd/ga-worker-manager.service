[Unit]
Description=GenericAgent Worker Manager (retired placeholder; no container runtime access)
Documentation=https://github.com/Imzl-zl/GenericAgent/tree/main/docs/superpowers/specs/2026-07-23-multi-tenant-implementation-boundaries-design.md
After=ga-platform.service
Requires=ga-platform.service
ConditionPathExists=/etc/ga/enable-legacy-worker-manager

[Service]
Type=oneshot
RemainAfterExit=no

# This unit is intentionally inert. The legacy worker-manager deployment path
# previously held Podman permissions, which violates the document platform rule
# that cmd/document-manager is the sole Docker/Podman holder. Do not grant this
# service access to any container runtime socket or runtime binary.
User=ga-platform
Group=ga-platform
SupplementaryGroups=ga-delivery
WorkingDirectory=/opt/ga
ExecStart=/usr/bin/false

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ga-worker-manager

[Install]
WantedBy=multi-user.target
