[Unit]
Description=GenericAgent Worker Manager (Podman container isolation)
Documentation=https://github.com/Imzl-zl/GenericAgent/tree/main/docs/superpowers/specs/2026-07-23-multi-tenant-implementation-boundaries-design.md
After=network-online.target podman.socket ga-platform.service
Wants=network-online.target podman.socket
Requires=ga-platform.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s

# Resource limits — the manager itself is light; the heavy lifting happens
# inside Worker containers, which are capped separately via Podman cgroups.
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

EnvironmentFile=-/etc/ga/worker-manager.env

User=ga
Group=ga
WorkingDirectory=/opt/ga

# ExecStart — listens on loopback TCP. P2 hardening: switch to a systemd
# .socket unit and unix:// listen address to avoid any network exposure.
# Flags must match cmd/worker-manager/main.go exactly:
#   --listen   gRPC listen address (default 127.0.0.1:50051)
#   --image    Worker container image
#   --podman   Podman binary path
# config-root/runtime-root are passed per-allocate via gRPC metadata
# (P2 enhancement: add --config-root/--runtime-root server-side defaults).
ExecStart=/opt/ga/bin/worker-manager \
  --listen=127.0.0.1:50051 \
  --image=ghcr.io/imzl-zl/genericagent-worker:latest \
  --podman=/usr/bin/podman

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ga /etc/ga/config /run/ga
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ga-worker-manager

[Install]
WantedBy=multi-user.target
