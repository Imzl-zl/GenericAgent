[Unit]
Description=GenericAgent Platform (control plane)
Documentation=https://github.com/Imzl-zl/GenericAgent/tree/main/docs/superpowers/specs/2026-07-21-multi-tenant-architecture.md
After=network-online.target postgresql.service ga-bot-poller.service
Wants=network-online.target postgresql.service
Requires=ga-bot-poller.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s

# Resource limits — tune per host. The 2 vCPU / 4 GiB reference host uses
# these values; raise on bigger boxes. MemoryMax pairs with the per-task
# cap enforced inside the Worker container (cgroup v2).
MemoryMax=2G
TasksMax=512
LimitNOFILE=4096

# Environment — supplied via /etc/ga/platform.env (not committed). The file
# must define DATABASE_URL, BOT_TOKEN_KEY, PLATFORM_WEBHOOK_SECRET,
# LLM_PROXY_CAPABILITY_SIGNING_KEY, and any optional quota tunables.
EnvironmentFile=-/etc/ga/platform.env
# Worker document capability points back to this loopback-only process. The
# signed runtime config never exposes PostgreSQL or container runtime access.
Environment=DOCUMENT_GATEWAY_BASE_URL=http://127.0.0.1:8080/v1/document

# User isolation — never run as root. Runtime socket denial below remains
# effective even if this account is accidentally added to docker/podman groups.
User=ga-platform
Group=ga-platform
SupplementaryGroups=ga-delivery
UMask=0027

# Working directory — needed so relative paths in flags resolve.
WorkingDirectory=/opt/ga

# ExecStart — platform stays loopback-only and uses the Python worker loopback
# path. Container access for secure document jobs belongs only to
# cmd/document-manager; do not add Docker/Podman flags or sockets here.
ExecStart=/opt/ga/bin/platform \
  --policy-file=/opt/ga/policy/foundation.v1.json \
  --claim-lease=30s \
  --dev-loopback \
  --listen=127.0.0.1:8080 \
  --runtime-root=/var/lib/ga/runtime \
  --config-root=/etc/ga/config \
  --legacy-root=/opt/ga/legacy \
  --worker-python=/usr/bin/python3 \
  --worker-src=/opt/ga/worker-python/src

# Sandboxing is part of the deployment boundary. Preflight rejects unit
# drop-ins, so changes require a reviewed unit revision rather than overrides.
NoNewPrivileges=true
PrivateTmp=true
# Hide standard rootful/rootless runtime sockets inside this service's mount
# namespace, including every per-user Podman socket under /run/user.
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/podman/podman.sock -/var/run/podman/podman.sock -/run/user /etc/ga/platform.env /etc/ga/document-manager.env /etc/ga/bot-poller.env /var/lib/ga/documents
UnsetEnvironment=DOCKER_HOST CONTAINER_HOST
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/ga/runtime /etc/ga/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Logging — systemd journal captures stdout/stderr automatically. No
# separate logrotate needed; journal has built-in size-based rotation.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ga-platform

[Install]
WantedBy=multi-user.target
