[Unit]
Description=GenericAgent Document Manager (secure document job containers)
Documentation=https://github.com/Imzl-zl/GenericAgent/tree/main/.tasks/document-processing-platform/tasks/document-manager/SPEC.md
After=network-online.target postgresql.service ga-platform.service
Wants=network-online.target postgresql.service
Requires=ga-platform.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s

# The Document Manager is the only GA service that may access Docker/Podman.
# It owns only fresh document instance identities and lifecycle slots; platform
# and workers must not receive container runtime permissions or host mounts.
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

# Must define DATABASE_URL, DOCUMENT_MANAGER_WORK_ROOT, DOCUMENT_MANAGER_IMAGE,
# and any non-default immutable runtime limits. The image must be pinned as
# repository@sha256:<digest>; tags and latest are rejected at process start.
EnvironmentFile=-/etc/ga/document-manager.env

User=ga-document
Group=ga-document
WorkingDirectory=/opt/ga

ExecStart=/opt/ga/bin/document-manager \
  --database-url=${DATABASE_URL} \
  --owner=${DOCUMENT_MANAGER_OWNER} \
  --work-root=${DOCUMENT_MANAGER_WORK_ROOT} \
  --runtime-binary=${DOCUMENT_MANAGER_RUNTIME_BINARY} \
  --image=${DOCUMENT_MANAGER_IMAGE} \
  --seccomp-profile=${DOCUMENT_MANAGER_SECCOMP_PROFILE} \
  --uid=${DOCUMENT_MANAGER_UID} \
  --gid=${DOCUMENT_MANAGER_GID} \
  --memory-bytes=${DOCUMENT_MANAGER_MEMORY_BYTES} \
  --cpu-period=${DOCUMENT_MANAGER_CPU_PERIOD} \
  --cpu-quota=${DOCUMENT_MANAGER_CPU_QUOTA} \
  --pids-limit=${DOCUMENT_MANAGER_PIDS_LIMIT} \
  --tmpfs-bytes=${DOCUMENT_MANAGER_TMPFS_BYTES} \
  --deployment-max-active=${DOCUMENT_POOL_MAX_ACTIVE_HARD} \
  --claim-lease=${DOCUMENT_MANAGER_CLAIM_LEASE} \
  --heartbeat-interval=${DOCUMENT_MANAGER_HEARTBEAT_INTERVAL} \
  --poll-interval=${DOCUMENT_MANAGER_POLL_INTERVAL} \
  --command-poll-interval=${DOCUMENT_MANAGER_COMMAND_POLL_INTERVAL} \
  --shutdown-timeout=${DOCUMENT_MANAGER_SHUTDOWN_TIMEOUT}

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Rootless Docker/Podman is reached only through the service user's exact API
# sockets. Rootful endpoints and all unrelated per-user runtime/home paths stay
# hidden, and the manager never starts conmon/runc inside this unit.
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/podman/podman.sock -/var/run/podman/podman.sock /var/lib/ga/runtime /etc/ga/config /etc/ga/document-manager.env /etc/ga/platform.env /etc/ga/bot-poller.env /opt/ga/legacy /opt/ga/worker-python
BindReadOnlyPaths=-/run/user/%U/docker.sock -/run/user/%U/podman/podman.sock
ReadWritePaths=/var/lib/ga/documents
ProtectKernelTunables=true
ProtectKernelModules=true
# The manager must be able to inspect cgroup v2 limits through rootless Docker/Podman.
ProtectControlGroups=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ga-document-manager

[Install]
WantedBy=multi-user.target
