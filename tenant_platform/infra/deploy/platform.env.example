# Copy to /etc/ga/platform.env, replace every placeholder, set root:ga-platform, then chmod 640.
DATABASE_URL=CHANGE_ME
BOT_TOKEN_KEY=CHANGE_ME
BOT_POLLER_URL=http://127.0.0.1:8090
BOT_POLLER_API_SECRET=CHANGE_ME
PLATFORM_WEBHOOK_URL=http://127.0.0.1:8080/v1/im/webhook
PLATFORM_WEBHOOK_SECRET=CHANGE_ME
PLATFORM_DEV_TOKEN=CHANGE_ME
PLATFORM_DEV_USER_ID=CHANGE_ME
PLATFORM_DEV_USERNAME=platform-admin
LLM_PROXY_CAPABILITY_SIGNING_KEY=CHANGE_ME
GA_RUNTIME_DIR=/var/lib/ga/runtime
GA_CONFIG_ROOT=/etc/ga/config
GA_LEGACY_ROOT=/opt/ga/legacy
GA_WORKER_PYTHON=/usr/bin/python3
GA_WORKER_SRC=/opt/ga/worker-python/src
GA_MIGRATIONS_DIR=/opt/ga/migrations
DOCUMENT_POOL_MAX_ACTIVE_HARD=1
MAX_RUNNING_TASKS=1
PER_TENANT_RUNNING_LIMIT=1
PER_USER_QUEUE_LIMIT=20
