# Copy to .env and adjust if needed:
#   cp .env.example .env
#
# Start:
#   docker compose up -d
#
# Connection URL (password ends with a literal dot):
#   postgresql://admin:REDACTED@127.0.0.1:5432/genericagent?sslmode=disable
#
# Tests / platform:
#   export TEST_DATABASE_URL=postgresql://admin:REDACTED@127.0.0.1:5432/genericagent?sslmode=disable
#   export DATABASE_URL="$TEST_DATABASE_URL"

POSTGRES_USER=admin
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=genericagent
