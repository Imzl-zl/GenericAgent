# Copy to .env and adjust before first run:
#   cp .env.example .env
#   # then edit POSTGRES_PASSWORD to a strong secret
#
# Start:
#   docker compose up -d
#
# Connection URL (password ends with a literal dot in the example only because
# the real value is supplied by the operator; never commit a real password):
#   postgresql://admin:CHANGE_ME_BEFORE_UP.@127.0.0.1:5432/genericagent?sslmode=disable
#
# Tests / platform:
#   export TEST_DATABASE_URL=postgresql://admin:CHANGE_ME_BEFORE_UP.@127.0.0.1:5432/genericagent?sslmode=disable
#   export DATABASE_URL="$TEST_DATABASE_URL"

POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_UP.
POSTGRES_DB=genericagent
