# Copy this file to .env and replace every CHANGE_ME value.
# This is the only file you need to edit before starting Docker Compose.
# Do not commit the filled .env file.

COMPOSE_PROJECT_NAME=genericagent
GA_HTTP_BIND=127.0.0.1
GA_HTTP_PORT=8088
GA_POSTGRES_BIND=127.0.0.1
GA_POSTGRES_PORT=55432
GA_PLATFORM_IMAGE=genericagent-platform:local
GA_BOT_POLLER_IMAGE=genericagent-bot-poller:local
GA_WEB_IMAGE=genericagent-web:local
GA_POSTGRES_IMAGE=postgres@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777

POSTGRES_USER=genericagent
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=genericagent
DATABASE_URL=postgres://genericagent:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/genericagent?sslmode=disable

BOT_TOKEN_KEY=CHANGE_ME_64_HEX
BOT_POLLER_LISTEN=0.0.0.0:8090
BOT_POLLER_MEDIA_DIR=/var/lib/ga/bot-media
BOT_POLLER_URL=http://bot-poller:8090
BOT_POLLER_API_SECRET=CHANGE_ME_32_BYTE_SECRET
PLATFORM_WEBHOOK_URL=http://platform:8088/v1/im/webhook
PLATFORM_WEBHOOK_SECRET=CHANGE_ME_32_BYTE_SECRET
PLATFORM_DEV_TOKEN=CHANGE_ME_ADMIN_TOKEN
PLATFORM_DEV_USER_ID=1
PLATFORM_DEV_USERNAME=platform-admin
LLM_PROXY_CAPABILITY_SIGNING_KEY=CHANGE_ME_32_BYTE_SECRET

GA_RUNTIME_DIR=/var/lib/ga/runtime
GA_CONFIG_ROOT=/etc/ga/config
GA_LEGACY_ROOT=/opt/ga/legacy
GA_WORKER_PYTHON=/usr/local/bin/python3
GA_WORKER_SRC=/opt/ga/worker-python/src
GA_MIGRATIONS_DIR=/opt/ga/migrations
MAX_RUNNING_TASKS=1
PER_TENANT_RUNNING_LIMIT=1
PER_USER_QUEUE_LIMIT=20
TASK_IDLE_TIMEOUT_SECONDS=300
WORKER_IDLE_TTL_SECONDS=600

# ──────────────────────────────────────────────────────────────────────────────
# 🏃 GA Sandbox Runner 配置(方案 §8)
# ──────────────────────────────────────────────────────────────────────────────
# 执行模式: user_workspace_runner 为工作区 Runner; loopback 仅显式用于开发降级
GA_WORKER_EXECUTION_MODE=user_workspace_runner
# ga-runner 镜像(固定 digest; 本机构建后可替换为 registry 引用)
GA_RUNNER_IMAGE=ga-runner:local
# 全局并发 Runner 上限, 满载时 task 保持 queued
GA_RUNNER_MAX_ACTIVE=4
# Runner 空闲回收 TTL
GA_RUNNER_IDLE_TTL=30m
# 单 task 时长上限
GA_RUNNER_TASK_TIMEOUT=300s
# 容器资源限额
GA_RUNNER_MEMORY_BYTES=1073741824
GA_RUNNER_CPU_QUOTA=100000
GA_RUNNER_PIDS_LIMIT=128
# 内部 LLM Proxy 地址
GA_LLM_PROXY_ADDR=http://llm-proxy:8081

# ──────────────────────────────────────────────────────────────────────────────
# 🔐 Sandbox Manager 控制面(方案 §7)
# ──────────────────────────────────────────────────────────────────────────────
# Platform → Manager 控制 API 的 HMAC 共享密钥(至少 16 字节; Manager 与 Platform 必须一致)
GA_MANAGER_SECRET=CHANGE_ME_32_BYTE_SECRET
# Manager 实例标识(写入 Runner label, 孤儿回收归属判断)
GA_MANAGER_ID=sandbox-manager-1
# Manager 控制面地址(Platform 侧)
GA_MANAGER_ADDR=http://sandbox-manager:8091
# 工作区共享卷名(daemon 命名空间; compose 显式命名为 runner_workspaces)
GA_WORKSPACES_VOLUME=runner_workspaces
# 共享卷内工作区根
GA_WORKSPACES_ROOT=/var/lib/ga/workspaces
# 只读 memory 模板(首次工作区初始化来源)
GA_MEMORY_TEMPLATE=/ga/memory-template
# Worker → Platform Sophub 代理地址(留空 = 不启用 Sophub 能力)
GA_SOPHUB_PROXY_ADDR=
