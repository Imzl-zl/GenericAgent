# Copy to /etc/ga/document-manager.env for the 1Panel profile.
# Replace CHANGE_ME with the same PostgreSQL password configured in 1Panel.
# The 55432 port in DATABASE_URL must match GA_POSTGRES_PORT in 1Panel.
# Replace 1000 in XDG_RUNTIME_DIR and DOCKER_HOST with the actual ga-document UID.
DATABASE_URL=postgres://genericagent:CHANGE_ME@127.0.0.1:55432/genericagent?sslmode=disable
GA_MIGRATIONS_DIR=/opt/ga/migrations
DOCUMENT_MANAGER_OWNER=document-manager-01
DOCUMENT_MANAGER_WORK_ROOT=/var/lib/ga/documents
DOCUMENT_MANAGER_RUNTIME_BINARY=docker
DOCUMENT_MANAGER_IMAGE=docker.io/zhangl580/genericagent-document-tool@sha256:a67a176bc046e28d38ef24dc300b51b0066a1275ffa980b9d5d2b846669e7f61
DOCUMENT_MANAGER_SECCOMP_PROFILE=builtin
DOCUMENT_MANAGER_UID=1000
DOCUMENT_MANAGER_GID=1000
DOCUMENT_MANAGER_MEMORY_BYTES=268435456
DOCUMENT_MANAGER_CPU_PERIOD=100000
DOCUMENT_MANAGER_CPU_QUOTA=50000
DOCUMENT_MANAGER_PIDS_LIMIT=64
DOCUMENT_MANAGER_TMPFS_BYTES=67108864
DOCUMENT_POOL_MAX_ACTIVE_HARD=1
XDG_RUNTIME_DIR=/run/user/1000
DOCKER_HOST=unix:///run/user/1000/docker.sock
DOCUMENT_MANAGER_CLAIM_LEASE=30s
DOCUMENT_MANAGER_HEARTBEAT_INTERVAL=10s
DOCUMENT_MANAGER_POLL_INTERVAL=500ms
DOCUMENT_MANAGER_COMMAND_POLL_INTERVAL=250ms
DOCUMENT_MANAGER_SHUTDOWN_TIMEOUT=30s
