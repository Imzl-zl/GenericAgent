[Unit]
Description=GenericAgent Document Manager for 1Panel application stack
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
Environment=GA_DOCUMENT_STACK_MODE=1panel
Environment=GA_1PANEL_PLATFORM_HEALTH_URL=http://127.0.0.1:8088/healthz
EnvironmentFile=-/etc/ga/document-manager.env
User=ga-document
Group=ga-document
WorkingDirectory=/opt/ga
ExecStartPre=+/usr/bin/env GA_DOCUMENT_RUNTIME_PREFLIGHT=1 /usr/bin/bash /opt/genericagent/source/tenant_platform/infra/compose/document-runtime-preflight.sh
ExecStart=/opt/ga/bin/document-manager \
  --owner=${DOCUMENT_MANAGER_OWNER} \
  --work-root=${DOCUMENT_MANAGER_WORK_ROOT} \
  --runtime-binary=${DOCUMENT_MANAGER_RUNTIME_BINARY} \
  --image=${DOCUMENT_MANAGER_IMAGE} \
  --seccomp-profile=${DOCUMENT_MANAGER_SECCOMP_PROFILE} \
  --uid=${DOCUMENT_MANAGER_UID} \
  --gid=${DOCUMENT_MANAGER_GID} \
  --memory-bytes=${DOCUMENT_MANAGER_MEMORY_BYTES} \
  --cpu-period=${DOCUMENT_MANAGER_CPU_PERIOD} \
  --cpu-quota=${DOCUMENT_MANAGER_CPU_QUOTA} \
  --pids-limit=${DOCUMENT_MANAGER_PIDS_LIMIT} \
  --tmpfs-bytes=${DOCUMENT_MANAGER_TMPFS_BYTES} \
  --deployment-max-active=${DOCUMENT_POOL_MAX_ACTIVE_HARD} \
  --claim-lease=${DOCUMENT_MANAGER_CLAIM_LEASE} \
  --heartbeat-interval=${DOCUMENT_MANAGER_HEARTBEAT_INTERVAL} \
  --poll-interval=${DOCUMENT_MANAGER_POLL_INTERVAL} \
  --command-poll-interval=${DOCUMENT_MANAGER_COMMAND_POLL_INTERVAL} \
  --shutdown-timeout=${DOCUMENT_MANAGER_SHUTDOWN_TIMEOUT}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/podman/podman.sock -/var/run/podman/podman.sock /etc/ga/document-manager.env /opt/genericagent/compose /var/lib/ga/runtime /etc/ga/config /opt/ga/legacy /opt/ga/worker-python
BindReadOnlyPaths=-/run/user/%U/docker.sock -/run/user/%U/podman/podman.sock
ReadOnlyPaths=/opt/ga/migrations
ReadWritePaths=/var/lib/ga/documents
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ga-document-manager

[Install]
WantedBy=multi-user.target
